Package CMotiveAndObjective;
Class
Ascii
{
Public
{


I32
IsAscii
c : I32
()
{
Return c >= 0 && c <= 127;
}

I32
IsUpper
c : I32
()
{
Return c >= 65 && c <= 90;
}

I32
IsLower
c : I32
()
{
Return c >= 97 && c <= 122;
}

I32
IsAlpha
c : I32
()
{
Return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

I32
IsDigit
c : I32
()
{
Return c >= 48 && c <= 57;
}

I32
IsAlnum
c : I32
()
{
Return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57);
}

I32
IsHexDigit
c : I32
()
{
Return (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

I32
IsWhite
c : I32
()
{
Return c == 32 || (c >= 9 && c <= 13);
}

I32
IsBlank
c : I32
()
{
Return c == 32 || c == 9;
}

I32
IsControl
c : I32
()
{
Return (c >= 0 && c < 32) || c == 127;
}

I32
IsGraph
c : I32
()
{
Return c >= 33 && c <= 126;
}

I32
IsPrint
c : I32
()
{
Return c >= 32 && c <= 126;
}

I32
IsPunct
c : I32
()
{
Return c >= 33 && c <= 126 && !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57));
}

I32
ToLower
c : I32
()
{
Return (c >= 65 && c <= 90) ? c + 32 : c;
}

I32
ToUpper
c : I32
()
{
Return (c >= 97 && c <= 122) ? c - 32 : c;
}

I32
HexValue
c : I32
()
{
If (c >= 48 && c <= 57) { Return c-48; } If (c >= 65 && c <= 70) { Return c-55; } If (c >= 97 && c <= 102) { Return c-87; } Return -1;
}
}
};
