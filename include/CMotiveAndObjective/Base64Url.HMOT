// CMotiveAndObjective; BSL-1.0.
Package CMotiveAndObjective;
Class
Base64Url
{
Public
{
I64
EncodedLength
n : I64
()
{
If (n < 0 || n > 6917529027641081853) { Return -1; } size : I64 = (n/3)*4; remain : I64 = n % 3; If (remain > 0) { size+=remain+1; } Return size;
}
I32
Value
c : I32
()
{
If (c >= 65 && c <= 90) { Return c-65; } If (c >= 97 && c <= 122) { Return c-71; } If (c >= 48 && c <= 57) { Return c+4; } If (c == 45) { Return 62; } If (c == 95) { Return 63; } Return -1;
}
I64
Encode
data : Uchar*
n : I64
out : Uchar*
capacity : I64
()
{
codec : Base64Url = Zero; size : I64 = codec.EncodedLength(n); If (size < 0 || capacity < size || (n > 0 && (data == Null || out == Null))) { Return -1; }
table : Char* = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"; i : I64 = 0; j : I64 = 0;
While (i < n) { remain : I64 = n-i; x : U32 = (U32)data[i] << 16; If (remain > 1) { x |= (U32)data[i+1] << 8; } If (remain > 2) { x |= data[i+2]; }
out[j]=table[(x >> 18) & 63]; out[j+1]=table[(x >> 12) & 63]; If (remain > 1) { out[j+2]=table[(x >> 6) & 63]; } If (remain > 2) { out[j+3]=table[x & 63]; } i+=3; j+=4; } Return size;
}
I64
Decode
data : Uchar*
n : I64
out : Uchar*
capacity : I64
()
{
If (n < 0 || capacity < 0 || n % 4 == 1 || (n > 0 && data == Null)) { Return -1; } If (n == 0) { Return 0; }
size : I64 = (n/4)*3; remain : I64 = n % 4; If (remain > 0) { size+=remain-1; }
If (capacity < size || (size > 0 && out == Null)) { Return -1; }
codec : Base64Url = Zero; i : I64 = 0; While (i < n) { If (codec.Value(data[i]) < 0) { Return -2; } i++; }
If (remain == 2 && (codec.Value(data[n-1]) & 15) != 0) { Return -2; } If (remain == 3 && (codec.Value(data[n-1]) & 3) != 0) { Return -2; }
i=0; j : I64 = 0; While (i < n) { x : U32 = ((U32)codec.Value(data[i]) << 18) | ((U32)codec.Value(data[i+1]) << 12);
If (n-i > 2) { x |= (U32)codec.Value(data[i+2]) << 6; } If (n-i > 3) { x |= (U32)codec.Value(data[i+3]); }
If (j < size) { out[j]=(Uchar)(x >> 16); j++; } If (j < size) { out[j]=(Uchar)(x >> 8); j++; } If (j < size) { out[j]=(Uchar)x; j++; } i+=4; } Return size;
}

