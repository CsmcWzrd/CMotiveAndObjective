// CMotiveAndObjective; BSL-1.0.
Package CMotiveAndObjective;
Class
Csv
{
Private
{
input : Uchar*;
size : I64;
position : I64 = -1;
}
Public
{
I32
Bind
data : Uchar*
n : I64
()
{
If (n < 0 || (n > 0 && data == Null)) { Return -1; } input=data; size=n; position=0; If (n == 0) { position=-1; } Return 0;
}
I64
Next
out : Uchar*
capacity : I64
rowEnd : I32*
()
{
If (capacity < 0 || rowEnd == Null) { Return -1; } If (position < 0) { Return -4; }
pass : I32 = 0; count : I64 = 0; next : I64 = position; ending : I32 = 0;
While (pass < 2) {
p : I64 = position; count=0; quoted : I32 = 0; closed : I32 = 0;
If (p < size && input[p] == 34) { quoted=1; p++; }
While (p < size) {
c : Uchar = input[p];
If (quoted == 1) {
If (c == 34) { If (p+1 < size && input[p+1] == 34) { If (pass == 1) { out[count]=34; } count++; p+=2; } Else { p++; closed=1; Break; } }
Else { If (pass == 1) { out[count]=c; } count++; p++; }
} Else { If (c == 44 || c == 10 || c == 13) { Break; } If (c == 34) { Return -2; } If (pass == 1) { out[count]=c; } count++; p++; }
}
If (quoted == 1 && closed == 0) { Return -2; }
next=-1; ending=1;
If (p < size) { c : Uchar = input[p]; If (c == 44) { next=p+1; ending=0; } Else { If (c != 10 && c != 13) { Return -2; } p++; If (c == 13 && p < size && input[p] == 10) { p++; } If (p < size) { next=p; } } }
If (pass == 0 && (count > capacity || (count > 0 && out == Null))) { Return -3; } pass++;
}
position=next; *rowEnd=ending; Return count;
}

}
};
