// Internal JSON string scanner. BSL-1.0.
#include "CMotiveAndObjective/Utf8.HMOT"
#include "CMotiveAndObjective/Ascii.HMOT"
Package CMotiveAndObjective;
Class
JsonOps
{
Public
{
I64
String
data : Uchar*
n : I64
start : I64
out : Uchar*
emit : I32
decoded : I64*
()
{
If (start >= n || data[start] != 34) { Return -2; }
utf : Utf8 = Zero; ascii : Ascii = Zero; p : I64 = start+1; count : I64 = 0;
While (p < n) {
c : U32 = data[p]; If (c == 34) { *decoded=count; Return p+1; }
If (c < 32) { Return -2; } cp : U32 = c; width : I32 = 1;
If (c == 92) {
p++; If (p >= n) { Return -2; } c=data[p]; p++;
If (c == 34 || c == 92 || c == 47) { cp=c; }
Elif (c == 98) { cp=8; } Elif (c == 102) { cp=12; } Elif (c == 110) { cp=10; } Elif (c == 114) { cp=13; } Elif (c == 116) { cp=9; }
Elif (c == 117) {
If (n-p < 4) { Return -2; } cp=0; j : I32 = 0; While (j < 4) { digit : I32 = ascii.HexValue(data[p+j]); If (digit < 0) { Return -2; } cp=(cp << 4) | (U32)digit; j++; } p+=4;
If (cp >= 55296 && cp <= 56319) { If (n-p < 6 || data[p] != 92 || data[p+1] != 117) { Return -2; } p+=2; low : U32 = 0; j=0; While (j < 4) { digit : I32 = ascii.HexValue(data[p+j]); If (digit < 0) { Return -2; } low=(low << 4) | (U32)digit; j++; } p+=4; If (low < 56320 || low > 57343) { Return -2; } cp=65536+((cp-55296) << 10)+(low-56320); }
Elif (cp >= 56320 && cp <= 57343) { Return -2; }
} Else { Return -2; }
width=1; If (cp >= 65536) { width=4; } Elif (cp >= 2048) { width=3; } Elif (cp >= 128) { width=2; }
If (emit == 1) { utf.Encode(cp,out+count,width); }
} Else {
used : I32 = 0; value : I32 = utf.DecodeFirst(data+p,n-p,&used); If (value < 0) { Return -2; } width=used;
If (emit == 1) { j : I32 = 0; While (j < width) { out[count+j]=data[p+j]; j++; } } p+=width;
}
count+=width;
} Return -2;
}
}
};
