Package CMotiveAndObjective;
Class
Sha256
{
Public
{

I32
Digest
data : Uchar*
n : I64
out : Uchar*
capacity : I64
()
{

If (n < 0 || n > 2305843009213693951 || capacity < 32 || out == Null || (n > 0 && data == Null)) { Return -1; }
state : U32[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
k : U32[64] = {0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
block : Uchar[64]; w : U32[64];
total : I64 = ((n+72)/64)*64;
bits : U64 = (U64)n << 3;
offset : I64 = 0;
While (offset < total) {
j : I32 = 0;
While (j < 64) {
index : I64 = offset+j;
If (index < n) { block[j]=data[index]; }
Elif (index == n) { block[j]=128; }
Elif (index >= total-8) { block[j]=(Uchar)(bits >> ((total-1-index)*8)); }
Else { block[j]=0; }
j++;
}
j=0; While (j < 16) { w[j]=((U32)block[j*4] << 24) | ((U32)block[j*4+1] << 16) | ((U32)block[j*4+2] << 8) | (U32)block[j*4+3]; j++; }
While (j < 64) {
x : U32 = w[j-15]; y : U32 = w[j-2];
s0 : U32 = ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3);
s1 : U32 = ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10);
w[j]=w[j-16]+s0+w[j-7]+s1; j++;
}
a : U32 = state[0]; b : U32 = state[1]; c : U32 = state[2]; d : U32 = state[3];
e : U32 = state[4]; f : U32 = state[5]; g : U32 = state[6]; h : U32 = state[7];
j=0; While (j < 64) {
s1 : U32 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7));
choose : U32 = (e & f) ^ ((~e) & g);
t1 : U32 = h+s1+choose+k[j]+w[j];
s0 : U32 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10));
majority : U32 = (a & b) ^ (a & c) ^ (b & c);
t2 : U32 = s0+majority;
h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2; j++;
}
state[0]+=a; state[1]+=b; state[2]+=c; state[3]+=d; state[4]+=e; state[5]+=f; state[6]+=g; state[7]+=h;
offset+=64;
}
j : I32 = 0; While (j < 8) {
out[j*4]=(Uchar)(state[j] >> 24); out[j*4+1]=(Uchar)(state[j] >> 16); out[j*4+2]=(Uchar)(state[j] >> 8); out[j*4+3]=(Uchar)state[j]; j++;
}
Return 32;

}
}
};
