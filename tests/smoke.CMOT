#include "CMotiveAndObjective/HashMapI64.HMOT"
#include "CMotiveAndObjective/HashSetI64.HMOT"
#include "CMotiveAndObjective/MultiMapI64.HMOT"
#include "CMotiveAndObjective/StackI64.HMOT"
#include "CMotiveAndObjective/Utf16.HMOT"
#include "CMotiveAndObjective/IntegerText.HMOT"
#include "CMotiveAndObjective/Ascii.HMOT"
#include "CMotiveAndObjective/BitManip.HMOT"
#include "CMotiveAndObjective/AlgorithmsI64.HMOT"
#include "CMotiveAndObjective/ArrayVectorI64.HMOT"
#include "CMotiveAndObjective/DListI64.HMOT"
#include "CMotiveAndObjective/RedBlackTreeI64.HMOT"
#include "CMotiveAndObjective/SortedMapI64.HMOT"
#include "CMotiveAndObjective/QueueI64.HMOT"
#include "CMotiveAndObjective/Sha256.HMOT"
I32
main
()
{
 ascii : Ascii;
 bits : BitManip;
 vector : ArrayVectorI64;
 If (!ascii.IsAlpha(65) || ascii.IsAlpha(200)) { Return 1; }
 If (bits.PopCount((U64)255) != 8) { Return 2; }
 If (vector.Length() != 0 || vector.PushBack(1) != -1) { Return 3; }
 list : DListI64;
 tree : RedBlackTreeI64;
 map : SortedMapI64;
 queue : QueueI64;
 sha : Sha256;
 keys : I64[4]; values : I64[4]; ring : I64[4];
 out : I64 = 0;
 list.PushBack(42);
 cursor : Void* = list.Begin();
 If (list.Read(cursor,&out) != 0 || out != 42) { Return 4; }
 If (list.PopBack(&out) != 0 || out != 42) { Return 5; }
 tree.Insert(20); tree.Insert(10); tree.Insert(30);
 If (!tree.Contains(20) || tree.Remove(20) != 0 || tree.Contains(20)) { Return 6; }
 map.Bind(keys,values,4); map.Put(9,99);
 If (map.Get(9,&out) != 0 || out != 99) { Return 7; }
 queue.Bind(ring,4); queue.PushBack(7);
 If (queue.PopFront(&out) != 0 || out != 7) { Return 8; }
 input : Uchar[3] = {97,98,99}; digest : Uchar[32];
 If (sha.Digest(input,3,digest,32) != 32 || digest[0] != 186 || digest[31] != 173) { Return 9; }
 hash : HashMapI64; set : HashSetI64; multi : MultiMapI64; stack : StackI64; text : IntegerText; wide : Utf16;
 hk : I64[4]; hv : I64[4]; sk : I64[4]; hs : Uchar[4]; ss : Uchar[4]; st : I64[4]; bytes : Uchar[65]; used : I32 = 0;
 If (hash.Bind(hk,hv,hs,4) != 0 || hash.Put(5,55) != 0 || hash.Get(5,&out) != 0 || out != 55) { Return 10; }
 If (set.Bind(sk,ss,4) != 0 || set.Insert(5) != 0 || set.Insert(5) != 1) { Return 11; }
 If (multi.Bind(keys,values,4) != 0 || multi.Insert(1,2) != 0 || multi.Insert(1,3) != 0 || multi.Count(1) != 2) { Return 12; }
 If (stack.Bind(st,4) != 0 || stack.Push(42) != 0 || stack.Pop(&out) != 0 || out != 42) { Return 13; }
 If (wide.Encode(128512,bytes,4,1) != 4 || wide.DecodeFirst(bytes,4,1,&used) != 128512 || used != 4) { Return 14; }
 If (text.FormatI64(-9223372036854775807-1,10,bytes,65) != 20 || text.ParseI64(bytes,20,10,&out) != 0 || out != (-9223372036854775807-1)) { Return 15; }
 Return 0;
}
